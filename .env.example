# =====================================================================
#  Job Hunter IA · configuration
#  1. cp .env.example .env
#  2. remplis les valeurs marquées 👉
#  3. ./scripts/setup.sh
# =====================================================================

# --- Base de données (les mots de passe vides sont générés par setup.sh)
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=

# --- n8n
N8N_ENCRYPTION_KEY=
N8N_VERSION=latest
TIMEZONE=Europe/Paris
# URL publique de n8n (HTTPS obligatoire pour que Telegram puisse joindre le bot)
# 👉 avec ngrok : https://ton-domaine.ngrok-free.app/
N8N_WEBHOOK_URL=http://localhost:5678/

# --- IA (toute API compatible OpenAI : OpenAI, Mistral, Groq, OpenRouter, Ollama...)
# 👉 clé API
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- Telegram
# 👉 token donné par @BotFather
TELEGRAM_BOT_TOKEN=
# 👉 ton identifiant (le bot te le donne si tu lui écris avant de le renseigner)
TELEGRAM_CHAT_ID=

# --- France Travail (https://francetravail.io → créer une application → API « Offres d'emploi v2 »)
# 👉 identifiants de ton application
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# --- Dashboard web (généré par setup.sh si vide)
DASHBOARD_TOKEN=

# --- Tunnel HTTPS ngrok (optionnel : docker compose --profile tunnel up -d)
# https://dashboard.ngrok.com → Your Authtoken + Domains (un domaine gratuit est offert)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
